{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Conta Lelê design tokens. Import into Tailwind, Style Dictionary, Figma Tokens, or any token-aware tool.",
  "$version": "1.0.0",

  "color": {
    "bg":        { "value": "#fdf5d4", "description": "Cream — primary background" },
    "bg2":       { "value": "#fbe87f", "description": "Light yellow — secondary surface" },
    "bg3":       { "value": "#ffdc3a", "description": "Sunflower yellow — primary accent" },
    "ink":       { "value": "#2b1300", "description": "Deep coffee — text + primary button" },
    "inkDim":    { "value": "rgba(43,19,0,0.58)", "description": "Secondary text" },
    "accent":    { "value": "#c4390e", "description": "Burnt orange — eyebrows, links" },
    "surface":   { "value": "#ffffff" },
    "border":    { "value": "rgba(43,19,0,0.08)" },

    "stage": {
      "bg":      { "value": "#3d0738", "description": "Stage purple — alternate theme bg" },
      "bg2":     { "value": "#5a0d52" },
      "bg3":     { "value": "#7b0968" },
      "ink":     { "value": "#ffffff" }
    },

    "sunflower": {
      "petal":   { "value": "#ffcc1f" },
      "outline": { "value": "#c4390e" },
      "core":    { "value": "#5a2a0a" }
    }
  },

  "font": {
    "display":   { "value": "Fredoka One, Pacifico, cursive" },
    "ui":        { "value": "Nunito, system-ui, sans-serif" }
  },

  "fontSize": {
    "eyebrow":   { "value": "11px" },
    "caption":   { "value": "12px" },
    "body":      { "value": "14px" },
    "bodyDesktop": { "value": "16px" },
    "h3":        { "value": "18px" },
    "h2Mobile":  { "value": "22px" },
    "h2Desktop": { "value": "42px" },
    "h1Mobile":  { "value": "32px" },
    "h1Desktop": { "value": "64px" },
    "displayXl": { "value": "52px" }
  },

  "fontWeight": {
    "regular":  { "value": "400" },
    "medium":   { "value": "600" },
    "bold":     { "value": "700" },
    "extrabold":{ "value": "800" },
    "black":    { "value": "900" }
  },

  "letterSpacing": {
    "tight":    { "value": "-0.02em" },
    "tighter":  { "value": "-0.025em" },
    "eyebrow":  { "value": "0.16em" }
  },

  "radius": {
    "xs":       { "value": "8px" },
    "sm":       { "value": "12px" },
    "md":       { "value": "18px" },
    "lg":       { "value": "22px" },
    "xl":       { "value": "24px" },
    "pill":     { "value": "9999px" }
  },

  "space": {
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "24px" },
    "6":  { "value": "32px" },
    "7":  { "value": "48px" },
    "8":  { "value": "72px" }
  },

  "shadow": {
    "sm": { "value": "0 2px 6px -2px rgba(43,19,0,0.15)" },
    "md": { "value": "0 8px 18px -14px rgba(43,19,0,0.18)" },
    "lg": { "value": "0 20px 40px -20px rgba(43,19,0,0.3)" }
  },

  "voice": {
    "do": [
      "Use 2ª pessoa (você)",
      "Verbos sensoriais: contar, encantar, escutar, brincar, mediar",
      "Diminutivos só para objetos/histórias (sementinha, girassol)",
      "Linguagem profissional para professores"
    ],
    "dont": [
      "Coach speak (incrível, exclusivo, transforme sua vida)",
      "Diminutivos para se referir ao usuário adulto",
      "Inglês de marketing (must-have, top, etc.)"
    ]
  },

  "do_not_use": {
    "colors": ["#f586d5", "#ffbaf0", "#000000", "#ffffff em texto sobre fundo escuro"],
    "patterns": ["Glassmorphism", "Gradientes vermelho-roxo na mesma peça", "Botões retangulares"],
    "imagery": ["IA gerada", "Stock genérico de criança", "SVG hand-drawn de Lelê"]
  }
}
